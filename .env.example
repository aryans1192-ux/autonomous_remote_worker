# LLM provider: groq (default) | openai | anthropic
LLM_PROVIDER=groq
# Comma-separated fallback order. Default when unset: provider leads, then groq, openai.
# Examples:
#   LLM_FALLBACK_ORDER=openai,anthropic
#   LLM_FALLBACK_ORDER=anthropic,groq,openai
#LLM_FALLBACK_ORDER=

# Provider API keys (only the ones in your provider/fallback order are required)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default date for dataset queries
RCA_DATE=2026-08-25
